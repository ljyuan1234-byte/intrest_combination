# API
API_PORT=4000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NODE_ENV=development

# 账号密码注册/登录。SESSION_SECRET 仍用于后续签名/扩展，至少 32 字符。
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# 可选：OpenAI 兼容的大模型。未配置时健康 Agent 使用确定性回复。
# DeepSeek 当前模型：deepseek-flash / deepseek-v4-pro
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-7ada21f8225a45ce8197395fd74b6a09
# LLM_MODEL=deepseek-flash
# LLM_TIMEOUT_MS=30000

# 可选：OpenAI 兼容的 embedding 服务。DeepSeek 官方暂不提供 embedding。
# Qwen（阿里云百炼）示例：text-embedding-v4 / text-embedding-v3，单批最多 10 条。
# 中国区 Key 用 dashscope.aliyuncs.com；国际区 Key 用 maas.qwencloudapi.com。
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-7c10800174bc4d43b80edc293b9c3f19
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BATCH_SIZE=10
# EMBEDDING_TIMEOUT_MS=30000

# Local infrastructure
DATABASE_URL=postgresql://life:life@localhost:5432/life_assistant
REDIS_URL=redis://localhost:6379

# Tencent Cloud PostgreSQL (production example)
# DATABASE_URL=postgresql://life:password@your-tencentdb-host:5432/life_assistant?sslmode=require
# DATABASE_SSL=true
# 没有配置 CA 时可临时设为 false；生产更建议配置 CA 并保持 true。
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_SSL_CA=C:\certs\tencentdb-ca.pem
# DATABASE_POOL_MAX=10
