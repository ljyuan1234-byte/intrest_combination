# 复制为 deploy/.env.production 后填写；不要提交真实密钥。
NODE_ENV=production
API_PORT=4000

# 你的正式域名（Caddy 会自动申请 HTTPS 证书）
DOMAIN=life.example.com
APP_ORIGIN=https://life.example.com

# 同域部署留空，前端请求 /api/v1/*
NEXT_PUBLIC_API_URL=

# 方式 A：腾讯云 PostgreSQL（推荐生产）
DATABASE_URL=postgresql://life:password@your-tencentdb-host:5432/life_assistant?sslmode=require
DATABASE_SSL=true
# 如果实例证书未被系统信任，先设为 false；更安全的做法是配置 CA 后设为 true。
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_SSL_CA=/run/secrets/tencentdb-ca.pem
DATABASE_POOL_MAX=10

# 方式 B：Docker 容器 PostgreSQL（仅个人测试/低成本）
# 使用 docker-compose.db.yml 时填写；密码只用字母和数字，避免 URL 转义问题。
# POSTGRES_DB=life_assistant
# POSTGRES_USER=life
# POSTGRES_PASSWORD=change-this-password

# 至少 32 字符的随机值，可用 openssl rand -base64 48 生成
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# 账号密码注册/登录，不再需要一次性凭证或邮件投递配置。

# 可选：OpenAI 兼容的大模型。未配置时健康 Agent 使用确定性回复。
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-flash
# LLM_TIMEOUT_MS=30000
# LLM_MODE=smart
# LLM_MAX_OUTPUT_TOKENS=400
# LLM_MAX_INPUT_CHARS=8000
# LLM_DAILY_REQUEST_LIMIT=30
# LLM_DAILY_TOKEN_BUDGET=20000

# 可选：OpenAI 兼容的 embedding 服务。DeepSeek 官方暂不提供 embedding。
# Qwen（阿里云百炼）示例：text-embedding-v4 / text-embedding-v3，单批最多 10 条。
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BATCH_SIZE=10
# EMBEDDING_TIMEOUT_MS=30000
